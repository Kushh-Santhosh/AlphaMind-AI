# ==============================================================================
# AlphaMind AI — Master Environment Variable Template (.env.example)
# ==============================================================================
# Copy this file to '.env' before launching the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------

# App Execution Environment (Required | Options: development, staging, production)
ENVIRONMENT=development

# Application Log Verbosity (Required | Options: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Application Secret Key for JWT Signing (Required | Example: 256-bit random string)
SECRET_KEY=change_this_to_a_secure_256bit_random_secret_in_production

# Allowed CORS Origins (Required | Example: http://localhost:3000,https://alphamind.ai)
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 16 + TIMESCALEDB CONFIGURATION
# ------------------------------------------------------------------------------

# Database Username (Required | Default: alphamind)
POSTGRES_USER=alphamind

# Database Password (Required | Default: alphamind_dev_pass)
POSTGRES_PASSWORD=alphamind_dev_pass

# Database Name (Required | Default: alphamind_db)
POSTGRES_DB=alphamind_db

# Database Host (Required | Default: localhost for dev, postgres for docker)
POSTGRES_HOST=localhost

# Database Port (Required | Default: 5432)
POSTGRES_PORT=5432

# SQLAlchemy Async Connection URL (Required | Format: postgresql+asyncpg://...)
DATABASE_URL=postgresql+asyncpg://alphamind:alphamind_dev_pass@localhost:5432/alphamind_db

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & MESSAGE BROKER
# ------------------------------------------------------------------------------

# Redis Hostname (Required | Default: localhost for dev, redis for docker)
REDIS_HOST=localhost

# Redis Port (Required | Default: 6379)
REDIS_PORT=6379

# Redis Connection URL (Required | Format: redis://...)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. VECTOR DATABASE (CHROMADB)
# ------------------------------------------------------------------------------

# ChromaDB Host (Required | Default: localhost)
CHROMADB_HOST=localhost

# ChromaDB Port (Required | Default: 8001)
CHROMADB_PORT=8001

# ------------------------------------------------------------------------------
# 5. KNOWLEDGE GRAPH DATABASE (NEO4J)
# ------------------------------------------------------------------------------

# Neo4j Bolt URI (Required | Default: bolt://localhost:7687)
NEO4J_URI=bolt://localhost:7687

# Neo4j User (Required | Default: neo4j)
NEO4J_USER=neo4j

# Neo4j Password (Required | Default: alphamind_graph_pass)
NEO4J_PASSWORD=alphamind_graph_pass

# ------------------------------------------------------------------------------
# 6. MARKET DATA PROVIDERS (3-TIER FAILOVER ENGINE)
# ------------------------------------------------------------------------------

# Primary Market Data Provider API Key (Optional | Fallback: AlphaVantage -> yfinance)
POLYGON_API_KEY=your_polygon_api_key_here

# Macroeconomic Data Provider Key (Optional | Fallback: Cached Macro Datasets)
FRED_API_KEY=your_fred_api_key_here

# Secondary Market Data Key (Optional | Fallback: yfinance)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ------------------------------------------------------------------------------
# 7. MULTI-LLM MODEL REGISTRY API KEYS
# ------------------------------------------------------------------------------

# OpenAI API Key for GPT-4o / Reasoning (Optional | Fallback: Local Rule Engines)
OPENAI_API_KEY=sk-proj-your_openai_key_here

# Anthropic API Key for Claude 3.5 Sonnet (Optional)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Google Gemini API Key for Gemini 1.5 Pro (Optional)
GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# DeepSeek API Key for DeepSeek-R1 (Optional)
DEEPSEEK_API_KEY=sk-ds-your_deepseek_key_here

# Local Ollama / vLLM Endpoint (Optional | Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------

# Sentry DSN for Exception Tracking (Optional | Example: https://...@sentry.io/0)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# OpenTelemetry Collector Endpoint (Optional | Default: http://localhost:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
